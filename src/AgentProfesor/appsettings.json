{
  "AgentProfesor": {
    "DataDirectory": "%LOCALAPPDATA%\\AgentProfesor",
    "BackupExportDirectory": "%LOCALAPPDATA%\\AgentProfesor\\export",

    "Capture": {
      "PauseAfterSeconds": 60,
      "PeriodicSnapshotSeconds": 150,
      "PollIntervalMilliseconds": 2000,
      "LargePasteChars": 400,
      "MinTextLength": 3,
      "AppAllowlist": [ "WINWORD", "OUTLOOK", "notepad", "wordpad", "notepad++" ]
    },

    "Storage": {
      "FullKeyframeEveryNDiffs": 10,
      "DiffToFullThresholdPercent": 60,
      "CompressionLevel": 10,
      "LogRotationMinutes": 60,
      "LogFlushSeconds": 15
    },

    "Retention": {
      "Enabled": true,
      "KeepAllDays": 90,
      "ThinToHourlyDays": 365,
      "KeepDailyBeyond": true,
      "DailyRunHour": 4,
      "PruneLogFiles": false,
      "PruneLogFilesOlderThanDays": 730
    },

    "Ui": {
      "Hotkey": "Ctrl+Alt+Space",
      "RunAtLogon": true
    },

    "Update": {
      "RepoUrl": "https://github.com/matyasr-art/agent-profesor",
      "CheckIntervalHours": 6,
      "CheckOnStartup": true
    }
  }
}
